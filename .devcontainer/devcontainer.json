{
  "name": "clusterx-os",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "forwardPorts": [8005],
  "portsAttributes": {
    "8005": { "label": "clusterx-os", "onAutoForward": "openPreview" }
  },
  "postCreateCommand": "pip install -e '.[dev]' && clusterx-os migrate && clusterx-os seed-demo",
  "postStartCommand": "nohup clusterx-os serve --port 8005 > /tmp/clusterx.log 2>&1 &"
}
