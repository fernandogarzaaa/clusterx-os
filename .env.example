# --- App ---
APP_NAME=ClusterX OS
PORT=8005
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=change-me-in-production
SEED_ON_STARTUP=0

# --- Admin seed user (override in production) ---
ADMIN_EMAIL=admin@clusterx.local
ADMIN_PASSWORD=ChangeMe123!

# --- Optional LLM enhancement (leave blank for local-only mode) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBED_MODEL=text-embedding-3-small

# --- Embeddings backend: hashed (default, zero-dep) ---
EMBEDDINGS=hashed

# --- ClusterX OS product ---
# Inbound lead webhook key (send as X-API-Key header)
WEBHOOK_API_KEY=dev-webhook-key
# Run the APScheduler follow-up job in-process (every 60s). Keep 0 for tests.
RUN_SCHEDULER=0
# Default outbound channel: simulator (always works)
OUTBOUND_CHANNEL=simulator

# --- Twilio (SMS/WhatsApp via api.twilio.com). Leave blank to disable. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- WhatsApp Cloud API (graph.facebook.com). Leave blank to disable. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
