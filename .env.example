# ClusterX OS configuration. Copy to .env and edit. Every value can also be
# set as a plain environment variable. `clusterx-os check-config` validates it.

# --- App ---
APP_ENV=development              # development | production | test
APP_NAME=ClusterX OS
HOST=0.0.0.0
PORT=8005
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text
# Public https URL of this deployment (needed to verify Twilio signatures behind a proxy)
PUBLIC_BASE_URL=

# --- Database ---
# SQLite for a single node; Postgres for production:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/clusterx
DATABASE_URL=sqlite:///./data/app.db
AUTO_MIGRATE=1                   # run Alembic migrations on API startup

# --- Auth (production refuses to start with the defaults) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
BCRYPT_ROUNDS=12
COOKIE_SECURE=0                  # set 1 when served over https
CORS_ORIGINS=                    # comma-separated, empty = same-origin only
ADMIN_EMAIL=admin@clusterx.local # first admin, created on an empty database
ADMIN_PASSWORD=
SEED_DEMO_DATA=0                 # load demo leads (never in production)

# --- Inbound webhooks and limits ---
WEBHOOK_API_KEY=                 # X-API-Key for /api/webhooks/leads and /messages
WEBHOOK_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=600
MAX_UPLOAD_BYTES=2000000
IDEMPOTENCY_TTL_HOURS=24

# --- Booking ---
BUSINESS_TIMEZONE=UTC            # IANA name, e.g. Asia/Manila; availability is in this zone
SLOT_MINUTES=30
BOOKING_HORIZON_DAYS=14

# --- Calendar: local | google | calcom ---
CALENDAR_PROVIDER=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=            # OAuth refresh token with calendar scope
GOOGLE_CALENDAR_ID=primary
GOOGLE_SEND_UPDATES=none         # all | externalOnly | none
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=0
CALCOM_BASE_URL=https://api.cal.com

# --- CRM: local | hubspot ---
CRM_PROVIDER=local
HUBSPOT_ACCESS_TOKEN=            # private-app token with crm.objects.contacts.read/write
HUBSPOT_BASE_URL=https://api.hubapi.com

# --- LLM: offline | mock | openai (any OpenAI-compatible endpoint) ---
LLM_PROVIDER=offline
# Groq:       https://api.groq.com/openai/v1   (model e.g. llama-3.1-8b-instant)
# OpenRouter: https://openrouter.ai/api/v1     (model e.g. meta-llama/llama-3.1-8b-instruct:free)
# Ollama:     http://localhost:11434/v1        (model e.g. llama3.1, key not needed)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30
LLM_JSON_MODE=1

# --- Background worker (follow-ups, CRM outbox, cleanup) ---
RUN_SCHEDULER=0                  # 1 = run the worker inside the API process
SCHEDULER_INTERVAL_SECONDS=60
OUTBOX_MAX_ATTEMPTS=8

# --- Messaging channels: simulator | twilio | whatsapp ---
OUTBOUND_CHANNEL=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                     # +15551234567 or whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=1
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=           # any string; enter the same value in the Meta console
WHATSAPP_APP_SECRET=             # validates X-Hub-Signature-256 on inbound webhooks
WHATSAPP_API_VERSION=v21.0
